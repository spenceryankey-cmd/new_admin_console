{
  "name": "@beyondx/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:mock": "tsc -p tsconfig.json --outDir .mock-dist && node .mock-dist/dev/mock-server.js"
  },
  "dependencies": {
    "@beyondx/shared": "*",
    "@nestjs/common": "^10.4.7",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-express": "^10.4.7",
    "@supabase/supabase-js": "^2.46.1",
    "helmet": "^8.0.0",
    "jose": "^5.10.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2.1.4"
  }
}
