# Copy values into the right place. Never commit real keys.
#
# apps/api (Railway service variables)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
WEB_APP_URL=https://admin.example.com
CORS_ORIGINS=https://admin.example.com,http://localhost:5173
PORT=3000
# Where Xpert records live. Assumed until the schema export confirms them.
XPERT_TABLE=workers
XPERT_ID_COLUMN=id
XPERT_NAME_COLUMNS=full_name
XPERT_PHONE_COLUMN=phone
XPERT_CREATED_COLUMN=created_at
# Optional columns
# XPERT_AREA_COLUMN=
# XPERT_SKILLS_COLUMN=
# XPERT_GUARANTOR_NAME_COLUMN=
# XPERT_GUARANTOR_CONTACT_COLUMN=
# XPERT_GUARANTOR_RELATIONSHIP_COLUMN=
SWEEPS_ENABLED=true
#
# apps/web (Vercel project variables, safe to expose in the browser)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=https://YOUR-API.up.railway.app
