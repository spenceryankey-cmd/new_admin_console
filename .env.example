# Copy values into the right place. Never commit real keys.
#
# apps/api (Railway service variables)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
WEB_APP_URL=https://admin.example.com
CORS_ORIGINS=https://admin.example.com,http://localhost:5173
PORT=3000
# The hetzner database holds the Xpert records. Two connections, two database users.
# Inside one Railway project use the private address (host ends in .railway.internal) and HETZNER_SSL=disable.
# Anywhere else use the public address with HETZNER_SSL=require. Create the users yourself (see docs/SETUP.md).
HETZNER_DATABASE_URL=postgres://console_reader:PASSWORD@HOST:5432/DATABASE
HETZNER_WRITE_DATABASE_URL=postgres://console_writer:PASSWORD@HOST:5432/DATABASE
HETZNER_SSL=require
# Optional: the PEM of the certificate authority that signed the database certificate (use \n for new lines).
# HETZNER_CA_CERT=
SWEEPS_ENABLED=true
#
# apps/web (Vercel project variables, safe to expose in the browser)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=https://YOUR-API.up.railway.app
